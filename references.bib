@article{Wallwork2012,
   author = {Wallwork, R. S. and Fortgang, R. and Hashimoto, R. and Weinberger, D. R. and Dickinson, D.},
   title = {Searching for a consensus five-factor model of the Positive and Negative Syndrome Scale for schizophrenia},
   journal = {Schizophrenia Research},
   volume = {137},
   number = {1},
   pages = {246-250},
   abstract = {Although the developers of the Positive and Negative Syndrome Scale (PANSS) grouped items into three subscales, factor analyses indicate that a five-factor model better characterizes PANSS data. However, lack of consensus on which model to use limits the comparability of PANSS variables across studies. We counted “votes” from published factor analyses to derive consensus models. One of these combined superior fit in our Caucasian sample (n=458, CFI=.970), and in distinct Japanese sample (n=164, CFI=.964), relative to the original three-subscale model, with a sorting of items into factors that was highly consistent across the studies reviewed.},
   keywords = {Schizophrenia, Symptoms,  Cognition,  PANSS},
   ISSN = {0920-9964},
   DOI = {https://doi.org/10.1016/j.schres.2012.01.031},
   url = {https://www.sciencedirect.com/science/article/pii/S0920996412000564},
   year = {2012},
   type = {Journal Article}
}

@article{Shi2023,
   author = {Shi, W. and Fan, L. and Wang, H. and Liu, B. and Li, W. and Li, J. and Cheng, L. and Chu, C. and Song, M. and Sui, J. and Luo, N. and Cui, Y. and Dong, Z. and Lu, Y. and Ma, Y. and Ma, L. and Li, K. and Chen, J. and Chen, Y. and Guo, H. and Li, P. and Lu, L. and Lv, L. and Wan, P. and Wang, H. and Wang, H. and Yan, H. and Yan, J. and Yang, Y. and Zhang, H. and Zhang, D. and Jiang, T.},
   title = {Two subtypes of schizophrenia identified by an individual-level atypical pattern of tensor-based morphometric measurement},
   journal = {Cereb Cortex},
   volume = {33},
   number = {7},
   pages = {3683-3700},
   note = {\.},
   abstract = {Difficulties in parsing the multiaspect heterogeneity of schizophrenia (SCZ) based on current nosology highlight the need to subtype SCZ using objective biomarkers. Here, utilizing a large-scale multisite SCZ dataset, we identified and validated 2 neuroanatomical subtypes with individual-level abnormal patterns of the tensor-based morphometric measurement. Remarkably, compared with subtype 1, which showed moderate deficits of some subcortical nuclei and an enlarged striatum and cerebellum, subtype 2, which showed cerebellar atrophy and more severe subcortical nuclei atrophy, had a higher subscale score of negative symptoms, which is considered to be a core aspect of SCZ and is associated with functional outcome. Moreover, with the neuroimaging-clinic association analysis, we explored the detailed relationship between the heterogeneity of clinical symptoms and the heterogeneous abnormal neuroanatomical patterns with respect to the 2 subtypes. And the neuroimaging-transcription association analysis highlighted several potential heterogeneous biological factors that may underlie the subtypes. Our work provided an effective framework for investigating the heterogeneity of SCZ from multilevel aspects and may provide new insights for precision psychiatry.},
   keywords = {},
   ISSN = {1047-3211},
   DOI = {10.1093/cercor/bhac301},
   year = {2023},
   type = {Journal Article}
}

@article{Dazzi2016,
   author = {Dazzi, Federico and Shafer, Alan and Lauriola, Marco},
   title = {Meta-analysis of the Brief Psychiatric Rating Scale – Expanded (BPRS-E) structure and arguments for a new version},
   journal = {Journal of Psychiatric Research},
   volume = {81},
   pages = {140-151},
   abstract = {The factor structure of the 24 item BPRS-E was examined to determine the effect of additional items on consensus scales derived primarily from the 18 item BPRS. A meta-analysis (k = 32, n = 10,084) of previous factor analyses of the BPRS-E was conducted using both a co-occurrence similarity matrix and reproduced correlations. Components generally supporting the consensus scales were found suggesting four relatively invariant subscales: Affect (defined by the core items: anxiety, guilt, depression, suicidality), Positive Symptoms (hallucinations, unusual thought content, suspiciousness, grandiosity), Negative Symptoms (blunted affect, emotional withdrawal, motor retardation) and Activation (excitement, motor hyperactivity, elevated mood, distractibility). The additional BPRS-E items primarily contribute directly to a clear Activation dimension which expands and clarifies the traditional 18 item BPRS structure. Though not statistically supported in this meta-analysis, a fifth factor describing disorganization (conceptual disorganization, disorientation, self-neglect, mannerisms-posturing) was present in some analyses and should be considered. The five factor solution including a disorganization factor has theoretical validity based on the pentagonal model of schizophrenia while also containing the same four primary dimensions that were statistically supported in this meta-analysis. A new version of the BPRS (BPRS-26) with modified and additional items is presented. BPRS-26 is supposed to enhance the stability and the comprehensiveness of the scale and to more closely measure this five factor model.},
   keywords = {},
   ISSN = {0022-3956},
   DOI = {https://doi.org/10.1016/j.jpsychires.2016.07.001},
   url = {https://www.sciencedirect.com/science/article/pii/S0022395616301297},
   year = {2016},
   type = {Journal Article}
}



