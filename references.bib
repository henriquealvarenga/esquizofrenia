@article{Berrios1985,
   author = {Berrios, G. E.},
   title = {Positive and negative symptoms and Jackson. A conceptual history},
   journal = {Arch Gen Psychiatry},
   volume = {42},
   number = {1},
   pages = {95-7},
   note = {},
   abstract = {The old distinction between positive and negative symptoms has of late been reclaimed to describe the symptomatology of schizophrenia. The commonly held view that it originated with J. H. Jackson is inaccurate. This distinction should be attributed to J. R. Reynolds; current usage is reynoldian in that it does not presuppose the complex theoretical model that characterized the jacksonian view.},
   keywords = {},
   ISSN = {0003-990X (Print) 0003-990x},
